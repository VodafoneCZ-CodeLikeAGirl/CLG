        <entry key="$PROJECT_DIR$/2026/koncert/o-nas/onas.html">
          <value>
            <PendingDiffInfo>
              <option name="filePath" value="$PROJECT_DIR$/2026/koncert/o-nas/onas.html" />
              <option name="originalContent" value="&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;en&quot;&gt;&#10;&lt;head&gt;&#10;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#10;    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#10;    &lt;title&gt;O nás&lt;/title&gt;&#10;    &lt;link rel=&quot;stylesheet&quot; href=&quot;onas.css&quot;&gt;&#10;&lt;/head&gt;&#10;&#10;&lt;body&gt;&#10;   &lt;main&gt;&#10;        &lt;h1&gt;O nás&lt;/h1&gt;&#10;&#10;&lt;div class=&quot;content&quot;&gt;&#10;        &lt;div class=&quot;uvod&quot;&gt;&#10;            &lt;h2&gt;Chromakiss&lt;/h2&gt;&#10;            &lt;p&gt;Jsme ChromaKiss pětičlenná dívčí popová skupina tvořená kamarádkami od dětství. Odjakživa nás spojovala láska k hudbě a společný sen tvořit vlastní písně. Ten se nám podařilo proměnit ve skutečnost a teď vyrážíme na naši první tour. Každá z nás přináší jinou barvu, ale dohromady tvoříme ChromaKiss.&lt;/p&gt;&#10;    &lt;/div&gt;&#10;            &#10;&lt;div class=&quot;skupina-clenek&quot;&gt;&#10;     &lt;div class=&quot;clenky&quot;&gt;&#10;        &lt;article class=&quot;clenka&quot;&gt;&#10;            &lt;h2&gt;Julča&lt;/h2&gt;&#10;            &lt;p&gt;&#10;               Julča působí v kapele jako zpěvačka a reprezentuje ji růžová barva.&#10;            &lt;/p&gt;&#10;        &lt;/article&gt;&#10;    &lt;/div&gt;&#10;&#10;&#10;     &lt;div class=&quot;clenky&quot;&gt;&#10;        &lt;article class=&quot;clenka&quot;&gt;&#10;            &lt;h2&gt;Ema&lt;/h2&gt;&#10;            &lt;p&gt;&#10;                Ema svým zpěvem obohacuje vystoupení kapely a její typickou barvou je fialová.&#10;            &lt;/p&gt;&#10;        &lt;/article&gt;&#10;    &lt;/div&gt;&#10;&#10;&#10;    &lt;div class=&quot;clenky&quot;&gt;&#10;        &lt;article class=&quot;clenka&quot;&gt;&#10;            &lt;h2&gt;Sofi&lt;/h2&gt;&#10;            &lt;p&gt;&#10;               Sofie se stará o další pěveckou část kapely a charakterizuje ji oranžová barva.&#10;            &lt;/p&gt;&#10;        &lt;/article&gt;&#10;        &lt;/div&gt;&#10;        &lt;div class=&quot;clenky&quot;&gt;&#10;&#10;        &lt;article class=&quot;clenka&quot;&gt;&#10;            &lt;h2&gt;Eliška&lt;/h2&gt;&#10;            &lt;p&gt;&#10;                Eliška doprovází kapelu hrou na kytaru a nejvíce ji vystihuje červená barva.&#10;            &lt;/p&gt;&#10;        &lt;/article&gt;&#10;        &lt;/div&gt;&#10;        &lt;div class=&quot;clenky&quot;&gt;&#10;&#10;        &lt;article class=&quot;clenka&quot;&gt;&#10;            &lt;h2&gt;Terka&lt;/h2&gt;&#10;            &lt;p&gt;&#10;                Terka se v kapele stará o rytmus hrou na bicí a její oblíbenou barvou je tyrkysová.&#10;            &lt;/p&gt;&#10;        &lt;/article&gt;&#10;        &lt;/div&gt;&#10;     &lt;/div&gt;&#10; &lt;/div&gt;&#10;&#10;    &lt;/main&gt;&#10;&#10;    &lt;footer id=&quot;footer&quot;&gt;&#10;    &lt;/footer&gt;&#10;    &lt;a href=&quot;/&quot; class=&quot;home-button&quot; aria-label=&quot;Přejít na první stránku&quot;&gt;&#10;  &amp;lt;&#10;&lt;/a&gt;&#10;      &#10;&lt;/body&gt; &#10;&lt;/html&gt;" />
              <option name="updatedContent" value="&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;en&quot;&gt;&#10;&lt;head&gt;&#10;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#10;    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#10;    &lt;title&gt;O nás&lt;/title&gt;&#10;    &lt;link rel=&quot;stylesheet&quot; href=&quot;onas.css&quot;&gt;&#10;&lt;/head&gt;&#10;&#10;&lt;body&gt;&#10;   &lt;main&gt;&#10;        &lt;h1&gt;O nás&lt;/h1&gt;&#10;&#10;&lt;div class=&quot;content&quot;&gt;&#10;        &lt;div class=&quot;uvod&quot;&gt;&#10;            &lt;h2&gt;Chromakiss&lt;/h2&gt;&#10;            &lt;p&gt;Jsme ChromaKiss pětičlenná dívčí popová skupina tvořená kamarádkami od dětství. Odjakživa nás spojovala láska k hudbě a společný sen tvořit vlastní písně. Ten se nám podařilo proměnit ve skutečnost a teď vyrážíme na naši první tour. Každá z nás přináší jinou barvu, ale dohromady tvoříme ChromaKiss.&lt;/p&gt;&#10;    &lt;/div&gt;&#10;            &#10;&lt;div class=&quot;skupina-clenek&quot;&gt;&#10;     &lt;div class=&quot;clenky&quot;&gt;&#10;        &lt;article class=&quot;clenka&quot;&gt;&#10;            &lt;h2&gt;Julča&lt;/h2&gt;&#10;            &lt;p&gt;&#10;               Julča působí v kapele jako zpěvačka a reprezentuje ji růžová barva.&#10;            &lt;/p&gt;&#10;        &lt;/article&gt;&#10;    &lt;/div&gt;&#10;&#10;&#10;     &lt;div class=&quot;clenky&quot;&gt;&#10;        &lt;article class=&quot;clenka&quot;&gt;&#10;            &lt;h2&gt;Ema&lt;/h2&gt;&#10;            &lt;p&gt;&#10;                Ema svým zpěvem obohacuje vystoupení kapely a její typickou barvou je fialová.&#10;            &lt;/p&gt;&#10;        &lt;/article&gt;&#10;    &lt;/div&gt;&#10;&#10;&#10;    &lt;div class=&quot;clenky&quot;&gt;&#10;        &lt;article class=&quot;clenka&quot;&gt;&#10;            &lt;h2&gt;Sofi&lt;/h2&gt;&#10;            &lt;p&gt;&#10;               Sofie se stará o další pěveckou část kapely a charakterizuje ji oranžová barva.&#10;            &lt;/p&gt;&#10;        &lt;/article&gt;&#10;        &lt;/div&gt;&#10;        &lt;div class=&quot;clenky&quot;&gt;&#10;&#10;        &lt;article class=&quot;clenka&quot;&gt;&#10;            &lt;h2&gt;Eliška&lt;/h2&gt;&#10;            &lt;p&gt;&#10;                Eliška doprovází kapelu hrou na kytaru a nejvíce ji vystihuje červená barva.&#10;            &lt;/p&gt;&#10;        &lt;/article&gt;&#10;        &lt;/div&gt;&#10;        &lt;div class=&quot;clenky&quot;&gt;&#10;&#10;        &lt;article class=&quot;clenka&quot;&gt;&#10;            &lt;h2&gt;Terka&lt;/h2&gt;&#10;            &lt;p&gt;&#10;                Terka se v kapele stará o rytmus hrou na bicí a její oblíbenou barvou je tyrkysová.&#10;            &lt;/p&gt;&#10;        &lt;/article&gt;&#10;        &lt;/div&gt;&#10;     &lt;/div&gt;&#10; &lt;/div&gt;&#10;&#10;    &lt;/main&gt;&#10;&#10;    &lt;footer id=&quot;footer&quot;&gt;&#10;    &lt;/footer&gt;&#10;    &lt;a href=&quot;../index.html&quot; class=&quot;home-button&quot; aria-label=&quot;Přejít na první stránku&quot;&gt;&#10;  &amp;lt;&#10;&lt;/a&gt;&#10;      &#10;&lt;/body&gt; &#10;&lt;/html&gt;" />
            </PendingDiffInfo>
